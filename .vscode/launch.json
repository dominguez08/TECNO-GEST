{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Iniciar TECNO-GEST (servidor y navegador)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/start.cjs",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "autoAttachChildProcesses": true,
      "serverReadyAction": {
        "pattern": "TECNO-GEST (?:ya está )?disponible en (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
